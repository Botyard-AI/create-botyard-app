{
  "name": "full-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "NODE_ENV=development node --watch-path=server server/index.ts --dev",
    "dev:mock": "NODE_ENV=development BOTYARD_RUNTIME_TRANSPORT=mock BOTYARD_RUNTIME_MOCK_FIXTURES=fixtures/dev.json BOTYARD_DEV_VIEWER=ada@example.com node --watch-path=server server/index.ts --dev",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.ts",
    "expose": "node scripts/expose.ts",
    "test": "vitest run",
    "typecheck": "tsc -b",
    "lint": "eslint --max-warnings 0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@botyard/botpage": "workspace:*",
    "@botyard/runtime": "workspace:*",
    "@radix-ui/react-avatar": "1.3.1",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.72.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "tailwind-merge": "3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tailwindcss/vite": "4.3.5",
    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.3.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-react-refresh": "0.4.26",
    "eslint-plugin-sonarjs": "4.2.2",
    "globals": "15.15.0",
    "prettier": "3.10.1",
    "tailwindcss": "4.3.5",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.2",
    "vite": "8.3.8",
    "vitest": "5.1.0"
  }
}
