{
  "name": "create-botyard-app",
  "version": "0.1.0",
  "description": "Scaffold a Botyard app: a Node API and a React UI, served as a Bot Page.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Botyard-AI/create-botyard-app.git",
    "directory": "packages/create-botyard-app"
  },
  "homepage": "https://github.com/Botyard-AI/create-botyard-app/tree/main/packages/create-botyard-app#readme",
  "bugs": "https://github.com/Botyard-AI/create-botyard-app/issues",
  "keywords": [
    "botyard",
    "bot-page",
    "scaffold",
    "create"
  ],
  "type": "module",
  "bin": {
    "create-botyard-app": "dist/bin.js"
  },
  "files": [
    "dist",
    "templates"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && node scripts/bundle-templates.ts"
  },
  "devDependencies": {
    "@botyard/eslint-config": "workspace:*",
    "@types/node": "^22.20.5",
    "eslint": "^10.15.0",
    "typescript": "6.0.3",
    "vitest": "^4.1.12"
  }
}
