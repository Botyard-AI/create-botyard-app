{
  "name": "@botyard/botpage",
  "version": "0.1.1",
  "description": "Viewer identity, membership guards and deeplinks for apps served as Botyard Bot Pages.",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Botyard-AI/create-botyard-app.git",
    "directory": "packages/botpage"
  },
  "homepage": "https://github.com/Botyard-AI/create-botyard-app/tree/main/packages/botpage#readme",
  "bugs": "https://github.com/Botyard-AI/create-botyard-app/issues",
  "keywords": [
    "botyard",
    "bot-page",
    "identity"
  ],
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./node": {
      "types": "./dist/node.d.ts",
      "default": "./dist/node.js"
    },
    "./hono": {
      "types": "./dist/hono.d.ts",
      "default": "./dist/hono.js"
    },
    "./next": {
      "types": "./dist/next.d.ts",
      "default": "./dist/next.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0 .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "hono": "^4.6.0"
  },
  "peerDependenciesMeta": {
    "hono": {
      "optional": true
    }
  },
  "devDependencies": {
    "@botyard/eslint-config": "workspace:*",
    "@hono/node-server": "^2.1.8",
    "@types/node": "^26.6.6",
    "eslint": "^10.15.0",
    "hono": "^4.13.0",
    "typescript": "5.9.3",
    "vitest": "^4.1.12"
  }
}
