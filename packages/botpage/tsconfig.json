{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // The Hono adapter's types (hono's websocket helper) refer to DOM event
    // types, and the adapters accept Fetch API values. The DOM lib keeps
    // `skipLibCheck: false` honest for the hono declarations we ship against.
    "lib": ["es2023", "DOM", "DOM.Iterable"]
  },
  "include": ["src", "test"]
}
