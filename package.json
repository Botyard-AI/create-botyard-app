{
  "name": "create-botyard-app-monorepo",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@11.15.1",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "eslint --max-warnings 0 . && pnpm -r --if-present run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json --noEmit && pnpm -r --if-present run typecheck",
    "test": "vitest run && pnpm --filter \"./templates/*\" run test",
    "test:coverage": "vitest run --coverage",
    "build": "pnpm -r --if-present run build",
    "knip": "knip"
  },
  "devDependencies": {
    "@botyard/eslint-config": "workspace:*",
    "@types/node": "^22.20.5",
    "@vitest/coverage-v8": "^4.1.12",
    "eslint": "^9.39.5",
    "knip": "^5.88.1",
    "prettier": "^3.10.1",
    "typescript": "5.9.3",
    "vitest": "^4.1.12"
  }
}
