{
  "$schema": "https://unpkg.com/knip@5/schema.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/release/*.mjs"],
      "project": ["*.{js,ts}", "scripts/**/*.mjs"]
    },
    "tooling/eslint-config": {
      "entry": ["*.js"],
      "project": ["*.js"]
    },
    "packages/runtime": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/botpage": {
      "entry": ["src/{index,node,hono,next}.ts"],
      "project": ["src/**/*.ts", "test/**/*.ts"]
    },
    "packages/create-botyard-app": {
      "entry": ["src/bin.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.ts", "test/**/*.ts"]
    },
    "packages/ui": {
      "project": ["**/*.js"]
    },
    "templates/full-app": {
      "entry": ["scripts/*.ts", "test/**/*.{ts,tsx}", "eslint/*.js"],
      "project": [
        "server/**/*.ts",
        "scripts/**/*.ts",
        "src/**/*.{ts,tsx}",
        "test/**/*.{ts,tsx}",
        "eslint/*.js"
      ],
      "ignoreDependencies": ["tailwindcss", "tw-animate-css"]
    }
  }
}
