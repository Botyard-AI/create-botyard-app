# Prettier also skips everything in .gitignore (dist, coverage, node_modules).
pnpm-lock.yaml
# Prose and workflow YAML keep their hand formatting; the monorepo formats code only.
*.md
.github/
# Verbatim copies from the monorepo, which does not format them; keeping them
# byte-identical makes re-syncing a plain copy.
tooling/eslint-config/base.js
tooling/eslint-config/node.js
tooling/eslint-config/react.js
# The template's ESLint configs are links to tooling/eslint-config.
templates/*/eslint/
# npm writes these; keep them byte-identical to what npm generates.
templates/*/package-lock.json
# Examples are standalone npm apps with their own Prettier config and
# format:check, run by scripts/check-examples.sh.
examples/
